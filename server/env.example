# Local development only: copy to .dev.vars, then replace selected placeholders.
# Production keys belong in Wrangler secrets, never [vars] or frontend config.
ALLOWED_ORIGIN=http://localhost:8000
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DASHSCOPE_API_KEY=replace-with-your-beijing-dashscope-key
MOONSHOT_API_KEY=replace-with-your-moonshot-key
ZHIPU_API_KEY=replace-with-your-zhipu-key
# Optional Beijing workspace domain; leave empty to use the existing DashScope domain.
DASHSCOPE_WORKSPACE_ID=
# Optional arbitrary OpenAI-compatible provider registry. Keep this in .dev.vars or
# a Wrangler secret/variable, never in browser code. Each secretEnv names another
# server-side secret; the browser may only select IDs/models returned by /api/models.
# MODEL_PROVIDERS_JSON=[{"id":"my-provider","label":"My Provider","baseUrl":"https://api.example.com/v1","models":["my-model"],"secretEnv":"MY_PROVIDER_API_KEY","protocol":"openai-compatible"}]
# MY_PROVIDER_API_KEY=replace-with-your-compatible-provider-key
# Optional native protocols (server-side only): protocol can be
# "anthropic-messages" or "gemini-generate-content". Use the provider's
# public API root as baseUrl; the Worker appends /messages or
# /models/{model}:generateContent. Never place a key in this JSON.
# MODEL_PROVIDERS_JSON=[{"id":"claude","label":"Claude","baseUrl":"https://api.anthropic.com/v1","models":["claude-sonnet-4-5"],"secretEnv":"ANTHROPIC_API_KEY","protocol":"anthropic-messages"},{"id":"gemini","label":"Gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta","models":["gemini-2.5-flash"],"secretEnv":"GEMINI_API_KEY","protocol":"gemini-generate-content"}]
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# GEMINI_API_KEY=replace-with-your-gemini-key
# Or configure one provider with CUSTOM_BASE_URL/CUSTOM_MODEL/CUSTOM_API_KEY/CUSTOM_LABEL.
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=replace-with-your-compatible-provider-key
CUSTOM_LABEL=Custom OpenAI-compatible
MAX_TOKENS=2048
REQUEST_TIMEOUT_MS=30000
